# ============================================================
#  J.A.R.V.I.S. AI Assistant — environment variables
# ============================================================
#  HOW TO USE:
#    1. Copy this file to .env  →  Windows:  copy .env.example .env
#                               →  Mac/Linux: cp .env.example .env
#    2. Fill in YOUR values. Nothing is auto-filled for you.
#    3. Restart the assistant afterwards.
#
#  ⚠️  Never commit your real .env file (it is gitignored).
# ============================================================

# ── REQUIRED ─────────────────────────────────────────────────
# Your name — the assistant greets you by it.
USER=YourName

# What the assistant calls itself (shown on the HUD).
BOTNAME=JARVIS

# ── EMAIL (used by the "send email to ..." command) ──────────
# Your Gmail address.
EMAIL=your.email@example.com
# NOT your normal password. With 2-Step Verification enabled,
# create an "App password" here:
#   https://myaccount.google.com/apppasswords
PASSWORD=your_gmail_app_password

# ── WEATHER ──────────────────────────────────────────────────
# Primary: WeatherAPI.com — free tier: 1,000,000 calls/month.
# Grab a key at https://www.weatherapi.com/signup.aspx
WEATHERAPI_KEY=
# Fallback: OpenWeatherMap — https://openweathermap.org/api
# (if WeatherAPI is empty AND this is empty, the key-free
#  wttr.in service answers automatically — no key needed)
OPENWEATHER_APP_ID=

# ── NEWS ─────────────────────────────────────────────────────
# Primary: GNews.io — free tier: 100 requests/day.
# https://gnews.io/
GNEWS_API_KEY=
# Fallback: NewsAPI.org (free developer tier).
# https://newsapi.org/
NEWS_API_KEY=

# ── WEB SEARCH ───────────────────────────────────────────────
# Optional fallback for the "google ..." / web-search command.
# Primary search uses DuckDuckGo (free, no key needed).
# https://serpapi.com/
SERPAPI_KEY=

# ── MOVIES ───────────────────────────────────────────────────
# The Movie Database — for trending-movie lookups.
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=
